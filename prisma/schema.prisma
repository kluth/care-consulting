generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// User & Authentication (ADR-0006: Auth0)
// ============================================

model User {
  id            String   @id @default(cuid())
  auth0Id       String   @unique // Auth0 user ID (sub claim)
  email         String   @unique
  name          String?
  avatarUrl     String?
  role          UserRole @default(STUDENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  enrollments   Enrollment[]
  payments      Payment[]
  chatMessages  ChatMessage[]
  progress      LessonProgress[]

  // Gamification
  xp            Int      @default(0)
  level         Int      @default(1)
  badges        UserBadge[]
  certificates  Certificate[]

  // Affiliate
  affiliateCode String?  @unique // Code this user shares
  referredBy    String?  // Who referred this user
  referrals     Referral[] @relation("Referrer")
  commissions   AffiliateCommission[]
  auditRuns     AuditRun[]

  // Fortbildung (Continuing Education - ADR-0016, ADR-0017)
  careRole              CareRole?  // Role in care facility
  facilityId            String?    // Reference to employing facility
  fortbildungEntries    FortbildungEntry[]
  fortbildungPeriods    FortbildungPeriod[]
  fortbildungCertificates FortbildungCertificate[]
  notificationPreferences NotificationPreference?

  // Wellness (ADR-0018)
  wellnessCheckIns      WellnessCheckIn[]
  burnoutAssessments    BurnoutAssessment[]

  // Shift-Aware Learning (ADR-0019)
  shifts                UserShift[]
  microProgress         MicroLessonProgress[]

  // AI Documentation (ADR-0021)
  docDrafts             DocumentationDraft[]
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

// ... existing models ...

// ============================================
// Affiliate System
// ============================================

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String @unique // The new user
  status      ReferralStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ReferralStatus {
  PENDING
  CONVERTED // Made a purchase
  PAID      // Commission paid
}

model AffiliateCommission {
  id          String   @id @default(cuid())
  userId      String   // The affiliate
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  currency    String   @default("EUR")
  reason      String   // e.g. "Course Purchase: C1"
  status      CommissionStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// ============================================
// Audit Cockpit (ADR-0013)
// ============================================

model AuditTemplate {
  id          String   @id @default(cuid())
  title       String   // "Ambulant 2025"
  description String?
  type        FacilityType
  version     String   @default("1.0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    AuditSection[]
  runs        AuditRun[]
}

enum FacilityType {
  AMBULANT
  STATIONAER
  TAGESPFLEGE
}

model AuditSection {
  id          String   @id @default(cuid())
  templateId  String
  template    AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  order       Int      @default(0)
  
  questions   AuditQuestion[]
}

model AuditQuestion {
  id          String   @id @default(cuid())
  sectionId   String
  section     AuditSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text        String
  hint        String?  // Help text
  points      Int      @default(10)
  isKoCriteria Boolean @default(false)
  order       Int      @default(0)

  answers     AuditAnswer[]
}

model AuditRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    AuditTemplate @relation(fields: [templateId], references: [id])
  
  status      AuditStatus @default(IN_PROGRESS)
  score       Float?   // Calculated Grade (1.0 - 5.0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answers     AuditAnswer[]
}

enum AuditStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model AuditAnswer {
  id          String   @id @default(cuid())
  runId       String
  run         AuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  questionId  String
  question    AuditQuestion @relation(fields: [questionId], references: [id])
  
  value       AnswerValue
  note        String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([runId, questionId])
}

enum AnswerValue {
  YES
  NO
  NOT_APPLICABLE
}

// ============================================
// Gamification (ADR-0011)
// ============================================

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "first-course"
  name        String
  description String?
  iconUrl     String?
  xpValue     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  issuedAt      DateTime @default(now())
  verificationId String  @unique @default(cuid()) // Public verification code
  pdfUrl        String?  // If we store it, otherwise generated on fly

  @@unique([userId, courseId])
  @@index([userId])
}

// ============================================
// Landing Page / Lead Generation
// ============================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  consent   Boolean  @default(false)
  source    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    InquiryStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InquiryStatus {
  PENDING
  REPLIED
  ARCHIVED
}

// ============================================
// Education Platform - Courses (ADR-0007: Mux)
// ============================================

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  shortDescription String?
  price         Decimal  @default(0)
  currency      String   @default("EUR")
  thumbnailUrl  String?
  published     Boolean  @default(false)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  lessons       Lesson[]
  enrollments   Enrollment[]
  liveSessions  LiveSession[]
  chatRoom      ChatRoom?
  certificates  Certificate[]
}

model Lesson {
  id            String   @id @default(cuid())
  title         String
  description   String?
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Mux Video (ADR-0007)
  muxAssetId    String?  // Mux asset ID for management
  muxPlaybackId String?  // Mux playback ID for streaming
  muxSigningKeyId String? // For signed URLs

  duration      Int?     // Duration in seconds
  order         Int      @default(0)
  isFree        Boolean  @default(false) // Preview lesson
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  progress      LessonProgress[]

  @@index([courseId])
}

model LessonProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  watchedSeconds Int     @default(0)
  completed     Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ============================================
// Enrollments & Payments (ADR-0010: Stripe)
// ============================================

model Enrollment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime @default(now())
  expiresAt     DateTime? // For time-limited access

  // Payment reference
  paymentId     String?  @unique
  payment       Payment? @relation(fields: [paymentId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

model Payment {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe data
  stripeSessionId     String   @unique
  stripePaymentIntentId String?
  stripeCustomerId    String?

  amount              Decimal
  currency            String   @default("EUR")
  status              PaymentStatus @default(PENDING)

  // Metadata
  courseId            String?
  courseTitle         String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  completedAt         DateTime?

  // Relations
  enrollment          Enrollment?

  @@index([userId])
  @@index([stripeSessionId])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// ============================================
// Live Sessions (ADR-0008: Zoom)
// ============================================

model LiveSession {
  id            String   @id @default(cuid())
  title         String
  description   String?
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Zoom integration
  zoomMeetingId String?
  zoomJoinUrl   String?
  zoomPassword  String?

  // Scheduling
  scheduledAt   DateTime
  duration      Int      // Duration in minutes
  timezone      String   @default("Europe/Berlin")

  status        LiveSessionStatus @default(SCHEDULED)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId])
  @@index([scheduledAt])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

// ============================================
// Real-time Chat (ADR-0009: Socket.io)
// ============================================

model ChatRoom {
  id            String   @id @default(cuid())
  name          String
  courseId      String   @unique
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  messages      ChatMessage[]
}

model ChatMessage {
  id            String   @id @default(cuid())
  content       String

  roomId        String
  room          ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  senderId      String
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Message metadata
  isEdited      Boolean  @default(false)
  isDeleted     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================
// Fortbildungsmanager (ADR-0016, ADR-0017)
// Continuing Education Compliance for Care Workers
// ============================================

// Care worker roles with different CE requirements
enum CareRole {
  PFLEGEFACHKRAFT       // 16h per 2 years
  PRAXISANLEITER        // 24h per year (12h must be pedagogical)
  PFLEGEHILFSKRAFT      // Facility-dependent
  PDL                   // Pflegedienstleitung (Manager)
}

// Category of continuing education
enum FortbildungCategory {
  FACHLICH              // Professional/technical
  PAEDAGOGISCH          // Pedagogical (required for Praxisanleiter)
  SONSTIGE              // Other
}

// A single continuing education entry (internal or external)
model FortbildungEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId      String?
  period        FortbildungPeriod? @relation(fields: [periodId], references: [id])

  // Training details
  title         String
  provider      String?  // External provider name
  description   String?
  hours         Float    // CE hours earned
  category      FortbildungCategory @default(FACHLICH)
  trainingDate  DateTime // When the training was completed

  // Source tracking
  isInternal    Boolean  @default(false) // From platform course
  courseId      String?  // Reference to platform course if internal
  documentUrl   String?  // Uploaded certificate/proof

  // Verification
  isVerified    Boolean  @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?  // Admin user ID who verified

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([periodId])
  @@index([trainingDate])
}

// A compliance period (e.g., 2024-2025 for Pflegefachkraft)
model FortbildungPeriod {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Period definition
  startDate     DateTime
  endDate       DateTime
  careRole      CareRole // Role determines requirements

  // Requirements (calculated based on role, may be pro-rated)
  requiredHours Float    // Total hours required
  requiredPedagogicalHours Float @default(0) // For Praxisanleiter

  // Progress tracking (denormalized for performance)
  completedHours Float   @default(0)
  completedPedagogicalHours Float @default(0)

  // Status
  status        ComplianceStatus @default(IN_PROGRESS)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  entries       FortbildungEntry[]
  certificate   FortbildungCertificate?

  @@unique([userId, startDate, endDate])
  @@index([userId])
  @@index([endDate])
  @@index([status])
}

enum ComplianceStatus {
  IN_PROGRESS   // Period active, not yet complete
  COMPLIANT     // Requirements met
  AT_RISK       // <30 days remaining with incomplete hours
  NON_COMPLIANT // Period ended without meeting requirements
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED       // User already compliant
}

// Certificate for completed period (ADR-0016: RS256 JWT verification)
model FortbildungCertificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId      String   @unique
  period        FortbildungPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  // Certificate data
  shortId       String   @unique // Short URL-safe ID for QR code
  jwtToken      String   @db.Text // RS256 signed JWT for verification
  totalHours    Float
  pedagogicalHours Float @default(0)

  // PDF storage
  pdfUrl        String?

  // Status
  isRevoked     Boolean  @default(false)
  revokedAt     DateTime?
  revokedReason String?

  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([shortId])
}

// ============================================
// Wellness & Burnout Prevention (ADR-0018)
// ============================================

model WellnessCheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mood      Int      // 1-5 scale
  stress    Int      // 1-5 scale
  note      String?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model BurnoutAssessment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  score       Float    // Calculated CBI score
  answers     Json     // Raw answers for history
  
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ============================================
// Shift-Aware Learning (ADR-0019)
// ============================================

model UserShift {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  startTime   DateTime
  endTime     DateTime
  type        ShiftType @default(DAY)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([startTime, endTime])
}

enum ShiftType {
  DAY
  EVENING
  NIGHT
  LONG_DAY
}

model MicroLessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  
  status      MicroProgressStatus @default(IN_PROGRESS)
  lastReview  DateTime @default(now())
  nextReview  DateTime?
  box         Int      @default(1) // Spaced repetition box
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

enum MicroProgressStatus {
  IN_PROGRESS
  MASTERED
  RE-REVIEW_NEEDED
}

// ============================================
// Simulation-Based Learning (ADR-0020)
// ============================================

model Scenario {
  id            String   @id @default(cuid())
  title         String
  description   String?
  thumbnailUrl  String?
  
  // JSON structure for the branching graph
  // { nodes: { [id]: { text: string, type: 'start'|'choice'|'end', choices: [{text, nextId, points}] } } }
  content       Json     
  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  results       ScenarioResult[]
}

model ScenarioResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  
  score       Int      // 0-100
  decisions   Json     // History of nodes visited
  completedAt DateTime @default(now())

  @@index([userId])
  @@index([scenarioId])
}

// ============================================
// AI Documentation Assistant (ADR-0021)
// ============================================

model DocumentationDraft {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rawInput      String   @db.Text
  structuredData Json     // Extracted SIS facts
  status        DraftStatus @default(PENDING)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

enum DraftStatus {
  PENDING
  REVIEWED
  COMMITTED
  DISCARDED
}

// User notification preferences (ADR-0017: Multi-channel)
model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Channel preferences
  emailEnabled  Boolean  @default(true)
  pushEnabled   Boolean  @default(false)
  inAppEnabled  Boolean  @default(true)

  // Reminder preferences
  reminderDays  Int[]    @default([90, 60, 30, 7]) // Days before deadline

  // Manager alerts (for PDL)
  teamAlertsEnabled Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Scheduled reminders queue (managed by Bull/Redis - ADR-0017)
model FortbildungReminder {
  id            String   @id @default(cuid())
  userId        String
  periodId      String

  // Scheduling
  scheduledFor  DateTime
  daysRemaining Int      // 90, 60, 30, or 7

  // Delivery status
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  channels      String[] // ["email", "push", "in_app"]
  error         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodId, daysRemaining])
  @@index([scheduledFor])
  @@index([status])
}