{
  "name": "@care-consulting/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:frontend": "nx serve frontend",
    "dev:backend": "nx serve backend",
    "dev:all": "nx run-many --target=serve --projects=frontend,backend --parallel=2",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:ui": "nx run-many --target=test --all --ui",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "e2e": "nx e2e frontend-e2e",
    "e2e:ui": "nx e2e frontend-e2e --watch",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "prettier --write \"**/*.{ts,json,md,scss,html}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,scss,html}\"",
    "build:all": "nx run-many --target=build --all",
    "affected:test": "nx affected --target=test",
    "affected:build": "nx affected --target=build",
    "affected:lint": "nx affected --target=lint",
    "graph": "nx graph",
    "storybook": "nx storybook ui",
    "build-storybook": "nx build-storybook ui",
    "prepare": "husky",
    "commit": "cz",
    "release": "semantic-release",
    "docs": "compodoc -p apps/frontend/tsconfig.app.json -d dist/docs",
    "docs:serve": "compodoc -p apps/frontend/tsconfig.app.json -d dist/docs -s",
    "coverage:report": "nx run-many --target=test --all --coverage --coverageReporters=lcov",
    "generate:api-client": "./scripts/generate-api-client.sh",
    "analyze:frontend": "nx build frontend --stats-json && webpack-bundle-analyzer dist/apps/frontend/stats.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "build:pwa": "nx build frontend --configuration=production",
    "a11y": "pa11y-ci",
    "a11y:axe": "axe http://localhost:4200"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.5",
    "@angular-devkit/core": "^21.0.5",
    "@angular-devkit/schematics": "^21.0.5",
    "@angular/build": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "@angular/service-worker": "^21.0.8",
    "@axe-core/cli": "^4.11.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@compodoc/compodoc": "^1.1.32",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^22.3.3",
    "@nx/cypress": "^22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/js": "^22.3.3",
    "@nx/nest": "^22.3.3",
    "@nx/node": "22.3.3",
    "@nx/storybook": "^22.3.3",
    "@nx/vite": "^22.3.3",
    "@nx/vitest": "22.3.3",
    "@nx/web": "^22.3.3",
    "@nx/webpack": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@schematics/angular": "^21.0.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/angular": "^10.1.11",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.16",
    "angular-eslint": "^21.0.1",
    "autoprefixer": "^10.4.0",
    "commitizen": "^4.3.1",
    "cypress": "^15.8.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "msw-storybook-addon": "^2.0.6",
    "ng-packagr": "~21.0.0",
    "nx": "22.3.3",
    "pa11y-ci": "^4.0.1",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "~3.6.2",
    "prisma": "^7.2.0",
    "semantic-release": "^25.0.2",
    "storybook": "^10.1.0",
    "storybook-dark-mode": "^4.0.2",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.8",
    "webpack-bundle-analyzer": "^5.1.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular/common": "~21.0.0",
    "@angular/compiler": "~21.0.0",
    "@angular/core": "~21.0.0",
    "@angular/forms": "~21.0.0",
    "@angular/platform-browser": "~21.0.0",
    "@angular/router": "~21.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^7.2.0",
    "@sentry/angular": "^10.32.1",
    "@sentry/node": "^10.32.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "zod": "^4.3.5"
  },
  "eslintConfig": {
    "extends": [
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "overrides": {
    "tmp": ">=0.2.4",
    "external-editor": ">=3.1.0"
  }
}
